<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- read bank SMS (stays on the phone) -->
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <uses-permission android:name="android.permission.READ_SMS" />
    <!-- alerts, evening summary, background catch-up after restart -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- optional: the spot where you paid (one quick check per payment, only if you turn it on) -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <!-- app lock -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- Android 9 and older: needed to save backups to Documents/Money -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" />
    <!-- internet is used ONLY to download new versions of the app from GitHub. Money data is never sent. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Android 11+: lets Money list the Files apps that can open the downloaded update -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="application/vnd.android.package-archive" />
        </intent>
        <!-- Scan & Pay: find the UPI apps on the phone (Google Pay, PhonePe, Paytm, BHIM…) -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="upi" />
        </intent>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
        <package android:name="com.google.android.apps.nbu.paisa.user" />
        <package android:name="com.phonepe.app" />
        <package android:name="net.one97.paytm" />
        <package android:name="in.org.npci.upiapp" />
        <package android:name="com.dreamplug.androidapp" />
        <package android:name="in.amazon.mShop.android.shopping" />
        <package android:name="com.mobikwik_new" />
        <package android:name="com.naviapp" />
        <package android:name="money.super.payments" />
        <package android:name="com.sbi.upi" />
        <package android:name="com.google.android.documentsui" />
        <package android:name="com.android.documentsui" />
        <package android:name="com.google.android.apps.nbu.files" />
        <package android:name="com.sec.android.app.myfiles" />
        <package android:name="com.mi.android.globalFileexplorer" />
        <package android:name="com.android.fileexplorer" />
        <package android:name="com.coloros.filemanager" />
        <package android:name="com.oneplus.filemanager" />
        <package android:name="com.vivo.filemanager" />
        <package android:name="com.huawei.hidisk" />
        <package android:name="com.motorola.filemanager" />
        <package android:name="com.asus.filemanager" />
        <package android:name="com.miui.securitycenter" />
        <package android:name="com.coloros.safecenter" />
        <package android:name="com.oplus.safecenter" />
        <package android:name="com.vivo.permissionmanager" />
        <package android:name="com.iqoo.secure" />
        <package android:name="com.huawei.systemmanager" />
        <package android:name="com.oneplus.security" />
        <package android:name="com.asus.mobilemanager" />
        <package android:name="com.transsion.phonemaster" />
    </queries>

    <application
        android:name=".MoneyApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize|stateHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".SetupActivity" android:exported="false" />
        <activity android:name=".SettingsActivity" android:exported="false" />
        <activity android:name=".BudgetActivity" android:exported="false" />
        <activity android:name=".AccountsActivity" android:exported="false" />
        <activity android:name=".BillsActivity" android:exported="false" />
        <activity android:name=".People" android:exported="false" />
        <activity android:name=".Goals" android:exported="false" />
        <activity android:name=".Challenges" android:exported="false" />
        <activity android:name=".NetWorthActivity" android:exported="false" />
        <activity android:name=".TaxActivity" android:exported="false" />
        <activity android:name=".CardsActivity" android:exported="false" />
        <activity android:name=".Refunds" android:exported="false" />
        <activity android:name=".Reminders" android:exported="false" />
        <activity android:name=".Loans" android:exported="false" />
        <activity android:name=".Rewards" android:exported="false" />
        <activity android:name=".VoiceActivity" android:exported="false" android:theme="@style/Translucent"
            android:excludeFromRecents="true" android:taskAffinity=".voice" android:launchMode="singleTask" />
        <activity android:name=".AskActivity" android:exported="false" android:windowSoftInputMode="adjustResize|stateHidden" />
        <activity
            android:name=".LockActivity"
            android:exported="false"
            android:excludeFromRecents="true" />

        <!-- bank SMS as they arrive -->
        <receiver
            android:name=".SmsReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter android:priority="999">
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>

        <!-- payment app notifications (Google Pay, PhonePe, Paytm…) -->
        <service
            android:name=".PayListener"
            android:exported="true"
            android:label="@string/listener_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- evening summary; sets alarms again after a restart / update -->
        <receiver android:name=".DailyReceiver" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <service
            android:name=".BgJob"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <!-- in-app updates -->
        <service
            android:name=".UpdateJobService"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />
        <receiver android:name=".UpdateReadyReceiver" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.DOWNLOAD_COMPLETE" />
            </intent-filter>
        </receiver>

        <!-- names typed into the "Who was it?" notification -->
        <receiver android:name=".NameReceiver" android:exported="false" />
        <receiver android:name=".CashReceiver" android:exported="false" />

        <!-- home-screen widget -->
        <receiver android:name=".Widget" android:exported="true" android:label="@string/widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_info" />
        </receiver>
        <receiver android:name=".PayWidget" android:exported="true" android:label="@string/widget_pay_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_pay_info" />
        </receiver>

        <!-- quick-settings tiles -->
        <service android:name=".ScanTile" android:exported="true" android:label="@string/tile_scan"
            android:icon="@drawable/ic_qr_scan" android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter><action android:name="android.service.quicksettings.action.QS_TILE" /></intent-filter>
        </service>
        <service android:name=".VoiceTile" android:exported="true" android:label="@string/tile_voice"
            android:icon="@drawable/ic_mic" android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter><action android:name="android.service.quicksettings.action.QS_TILE" /></intent-filter>
        </service>
    </application>
</manifest>
